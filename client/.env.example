# Supabase > Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# The anon (public) key. Safe in the browser: Row Level Security limits what it can do.
VITE_SUPABASE_ANON_KEY=your-anon-key

# Base URL of the Express API. Leave empty in development (Vite proxies /api
# to http://localhost:3001), on Vercel, or when the server also serves the client.
# Example for a separate host: https://api.example.com
VITE_API_URL=
