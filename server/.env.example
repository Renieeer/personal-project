# Port the API listens on
PORT=3001

# Supabase > Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
# The service_role key bypasses Row Level Security. Keep it on the server only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email of the single admin user created in Supabase Auth.
# Only this account can use the /api/admin routes.
ADMIN_EMAIL=admin@example.com

# On Vercel only the three values above are needed (set them in the
# project's Environment Variables). The rest is for other setups.

# Comma-separated origins allowed to call the API from a browser.
# Not needed locally (Vite proxies /api) or on Vercel (same domain);
# required when the client is hosted on a different domain than the API.
CLIENT_ORIGIN=http://localhost:5173

# Set to true to also serve the built React app (client/dist) from this server.
SERVE_CLIENT=false

# Set to true behind a reverse proxy (Render, Railway, Nginx, ...) so the
# contact form rate limit sees the real visitor IP. Automatic on Vercel.
TRUST_PROXY=false
